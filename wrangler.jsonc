{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mon-app",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Pages et fichiers du dossier public/. Les routes /api/* et /vibe-kit.js passent par le Worker.
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/vibe-kit.js"]
  },

  // Base de données. database_id est rempli par `npm run setup`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mon-app-db",
      "database_id": "A_REMPLIR_PAR_SETUP",
      "migrations_dir": "migrations"
    }
  ]
}
