{
  "name": "mon-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types",
    "db:new": "wrangler d1 migrations create DB",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "ci:deploy": "wrangler d1 migrations apply DB --remote && wrangler deploy",
    "ci:preview": "wrangler d1 migrations apply DB --remote && wrangler versions upload",
    "kit:check": "vibe-kit version",
    "kit:sync": "vibe-kit sync",
    "kit:upgrade": "vibe-kit upgrade"
  },
  "dependencies": {
    "vibe-kit": "git+https://github.com/grams/vibe-kit.git",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  }
}
